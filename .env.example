# ---------------------------------------------------------------------------
# Foundation Exam System - environment configuration
# Copy to .env and edit.  NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Public hostname -------------------------------------------------------
# The hostname students will use.  With no domain name, use sslip.io: take your
# Oracle Cloud instance's PUBLIC IP and replace the dots with dashes.
#   Public IP 132.145.10.20  ->  132-145-10-20.sslip.io
# Caddy will automatically obtain a free Let's Encrypt certificate for it.
#
# If you later buy a real domain, change ONLY this line, point the domain's A
# record at the instance IP, and run `docker compose up -d`.  Nothing else.
PUBLIC_HOST=132-145-10-20.sslip.io

# Email used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=foundation
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=foundation

# --- Secrets ---------------------------------------------------------------
# Generate each of these with:  openssl rand -base64 48
# JWT_SECRET signs login sessions.
JWT_SECRET=change_me_openssl_rand_base64_48
# ENCRYPTION_KEY encrypts LLM API keys at rest in the database.
# WARNING: if you change this, previously saved API keys become unreadable.
ENCRYPTION_KEY=change_me_openssl_rand_base64_48

# --- Default administrator -------------------------------------------------
# Created on first boot only.  Change the password after your first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=foundation_123

# --- Behaviour -------------------------------------------------------------
# Minutes a login session stays valid, regardless of activity.
SESSION_TTL_MINUTES=720
# Minutes of complete inactivity before a session ends.  0 turns it off.
# A student writing a paper heartbeats every 20 seconds, so an exam in progress
# can never time out; this is for the machine somebody walked away from.
IDLE_TIMEOUT_MINUTES=30
# One account, one device: signing in ends any other session for that account,
# so a username and password cannot be shared around a classroom.
SINGLE_DEVICE_LOGIN=true
# Keep this many nightly local snapshots before deleting the oldest.
BACKUP_RETENTION_DAYS=7
# Outbound request timeout for LLM providers, milliseconds.
LLM_TIMEOUT_MS=180000

# --- Local trial only ------------------------------------------------------
# Session cookies are marked Secure by default, so the browser will only send
# them over HTTPS.  Leave it that way on a real server.
#
# Set this to false ONLY when trying the system on a laptop or a school LAN
# over plain http:// - a browser refuses to store a Secure cookie from an
# address such as http://192.168.1.20, so without this nobody can sign in.
# docker-compose.local.yml already sets it for you.
# COOKIE_SECURE=false
