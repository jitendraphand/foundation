# ---------------------------------------------------------------------------
# Foundation Exam System - environment configuration
# Copy to .env and edit.  NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Public hostname -------------------------------------------------------
# The hostname students will use.  With no domain name, use sslip.io: take your
# Oracle Cloud instance's PUBLIC IP and replace the dots with dashes.
#   Public IP 132.145.10.20  ->  132-145-10-20.sslip.io
# Caddy will automatically obtain a free Let's Encrypt certificate for it.
#
# If you later buy a real domain, change ONLY this line, point the domain's A
# record at the instance IP, and run `docker compose up -d`.  Nothing else.
PUBLIC_HOST=132-145-10-20.sslip.io

# Email used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=foundation
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=foundation
# Database connections the API may hold, across all of its workers together.
# The default suits a class or two starting a paper at the same moment; raise it
# alongside DB_MAX_CONNECTIONS below, never past it.
DB_POOL_SIZE=20

# --- Sizing for the machine ------------------------------------------------
# Everything in this block has a safe default and can be left alone. It exists
# because two things do not size themselves, and both were measured with 200
# students on the system at once.
#
# WEB_CONCURRENCY is the important one. Node runs JavaScript on one thread, so
# one API process uses one core no matter how large the host is. Left at 0 the
# API starts one worker per core (capped at 8), which is what you want. Set it
# to 1 only to reproduce the old single-process behaviour.
WEB_CONCURRENCY=0

# Postgres ships assuming a very small machine and never looks at the host, so
# these are the figures to raise on a big one. Rules of thumb, from the Postgres
# documentation, for a machine doing nothing else:
#
#   shared_buffers        25% of RAM
#   effective_cache_size  50-75% of RAM  (a hint to the planner, not an
#                                         allocation - it reserves nothing)
#   work_mem              RAM / max_connections / 4, and it is per sort, so
#                         several may be in use by one query
#   maintenance_work_mem  1-2 GB is plenty; used by VACUUM and index builds
#
# The defaults below are deliberately modest so a 4 GB box is safe. For a
# 100 GB machine the corresponding values are commented beside each one.
DB_SHARED_BUFFERS=256MB           # 100 GB host: 24GB
DB_EFFECTIVE_CACHE=1GB            # 100 GB host: 72GB
DB_WORK_MEM=8MB                   # 100 GB host: 64MB
DB_MAINTENANCE_WORK_MEM=128MB     # 100 GB host: 2GB
DB_MAX_CONNECTIONS=100            # keep DB_POOL_SIZE comfortably below this

# --- Secrets ---------------------------------------------------------------
# Generate each of these with:  openssl rand -base64 48
# JWT_SECRET signs login sessions.
JWT_SECRET=change_me_openssl_rand_base64_48
# ENCRYPTION_KEY encrypts LLM API keys at rest in the database.
# WARNING: if you change this, previously saved API keys become unreadable.
ENCRYPTION_KEY=change_me_openssl_rand_base64_48

# --- Default administrator -------------------------------------------------
# Read once, when the first administrator is created on an empty database.
# Editing it afterwards changes nothing: use Change password in the admin
# header instead, and do it after your first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=foundation_123

# --- Behaviour -------------------------------------------------------------
# Minutes a login session stays valid, regardless of activity.
SESSION_TTL_MINUTES=720
# Minutes of complete inactivity before a session ends.  0 turns it off.
# A student writing a paper heartbeats every 20 seconds, so an exam in progress
# can never time out; this is for the machine somebody walked away from.
IDLE_TIMEOUT_MINUTES=30
# One account, one device: signing in ends any other session for that account,
# so a username and password cannot be shared around a classroom.
SINGLE_DEVICE_LOGIN=true
# Keep this many nightly local snapshots before deleting the oldest.
BACKUP_RETENTION_DAYS=7
# How long to wait with nothing arriving from an LLM provider, milliseconds.
# Replies are streamed, so this is a silence alarm rather than a deadline: a
# long answer may take many minutes, but a gap this long means the provider has
# stopped sending.
LLM_TIMEOUT_MS=180000
# Backstop for a streamed reply that never ends, milliseconds. Generous on
# purpose - it stops a run hanging for ever, it does not bound a big batch.
LLM_MAX_MS=900000

# --- Local trial only ------------------------------------------------------
# Session cookies are marked Secure by default, so the browser will only send
# them over HTTPS.  Leave it that way on a real server.
#
# Set this to false ONLY when trying the system on a laptop or a school LAN
# over plain http:// - a browser refuses to store a Secure cookie from an
# address such as http://192.168.1.20, so without this nobody can sign in.
# docker-compose.local.yml already sets it for you.
# COOKIE_SECURE=false
