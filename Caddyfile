{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	# The GitHub Pages landing button links here.  Everything under /api goes to
	# the Node service; everything else is the React single-page app.
	handle /api/* {
		reverse_proxy api:4000 {
			# LLM streaming (180s silence timeout + 15min max) must flush
			# chunks immediately; buffered proxy would hide the stream.
			flush_interval -1
			# Backup restore can take >60s for large archives (pg_restore + migrate).
			# Without explicit timeouts Caddy closes the connection → 502.
			transport http {
				dial_timeout 10s
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy api:4000
	}

	# n8n used to advertise its webhooks at https://<this host>/n8n/webhook/...
	# which is the website, so a copied Production URL never reached a
	# workflow. Keep that path working for URLs already saved in Settings.
	# handle_path strips /n8n before proxying; n8n listens at /webhook/.
	handle_path /n8n/* {
		reverse_proxy n8n:5678
	}

	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Plain HTTP on the raw IP is redirected to the canonical HTTPS hostname, so a
# student who types the bare IP still lands on the secure site.
:80 {
	redir https://{$PUBLIC_HOST}{uri} permanent
}

# n8n automation sidecar (part of docker-compose.yml). Basic auth is set
# inside the n8n container itself.
n8n.{$PUBLIC_HOST} {
	reverse_proxy n8n:5678
}
