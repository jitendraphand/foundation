# Caddy configuration for a trial on your own machine.
#
# Used only by docker-compose.local.yml. The production Caddyfile is untouched.
#
# The difference from production is the absence of a certificate: a laptop has
# no public hostname, so there is nothing Let's Encrypt could issue for and
# nothing to prove ownership of. Everything is served over plain HTTP instead.
# That is fine on a machine you control and on a school LAN; it is not fine on
# anything reachable from the internet.

{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# Same routing as production: /api and /uploads to the Node service,
	# everything else to the React single-page app.
	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				dial_timeout 10s
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy api:4000
	}

	# Same compatibility path as the production Caddyfile: a Production URL
	# copied while n8n still advertised /n8n/ on the app host.
	handle_path /n8n/* {
		reverse_proxy n8n:5678
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# n8n sidecar (part of docker-compose.yml), plain HTTP on the LAN.
# The http:// prefix matters: a bare hostname would be placed on :443 by
# default, where nothing is listening in this trial - so http:// requests
# would fall through to the app instead of n8n.
http://n8n.localhost {
	reverse_proxy n8n:5678
}
