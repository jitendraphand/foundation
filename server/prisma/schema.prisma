// ---------------------------------------------------------------------------
// Foundation Exam System - data model
//
// DESIGN RULES (these are what make the schema survive future upgrades):
//
//  1. Every table has a UUID primary key. Never a natural key, never an
//     auto-increment integer. Rows can therefore be merged across databases
//     during a restore without collisions.
//
//  2. Anything whose *shape* may change lives in a JSONB column carrying its
//     own `version` field (question content, chart specs, answer keys,
//     analytics snapshots). Adding a new kind of question block or a new
//     simulation widget is then a code change, not a database migration.
//
//  3. Anything queried, filtered, sorted or aggregated lives in a real typed
//     column with a real index. JSONB is for content, never for the fields
//     analytics runs on.
//
//  4. Every table has a `meta Json` escape hatch defaulting to {}. New
//     optional fields land there first and graduate to real columns later if
//     they turn out to be worth indexing.
//
//  5. Vocabularies (difficulty levels, cognitive levels, skills, grades,
//     divisions) are ROWS in the Tag / SchoolClass tables, not enum types.
//     Adding "very difficult" later is an INSERT, not a migration.
//     Only genuinely closed sets (user role, attempt status) are enums.
//
//  6. Deletes are soft wherever the row is referenced by historical results,
//     so an old score never loses the question it came from.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  // Both targets so the image builds on x86 laptops and arm64 servers alike.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Closed sets: safe as enums -------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum TestKind {
  REGULAR // a normal class test
  PRACTICE // remedial test generated for one student's weak areas
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionStatus {
  DRAFT // returned by the LLM, awaiting admin review
  APPROVED // admin accepted it; eligible to be placed on a test
  REJECTED // admin discarded it; kept for prompt-quality analysis
}

/// Multiple choice only: exactly one correct option, or several correct
/// options. Both are graded automatically with no human marking.
enum QuestionFormat {
  MCQ_SINGLE
  MCQ_MULTI
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED // timer expired
  ABANDONED
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum TagAxis {
  DIFFICULTY
  COGNITIVE
  SKILL
}

enum ActivityKind {
  FLASHCARD // cards only
  VIDEO // a video only
  MIXED // cards and a video
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// How a daily availability window is interpreted. See lib/availability.ts.
enum AvailabilityMode {
  ALWAYS // no daily restriction
  ALLOW_WINDOW // attemptable only inside the window, e.g. school hours
  BLOCK_WINDOW // paused inside the window, e.g. 11pm to 5am
}

// --- People ----------------------------------------------------------------

model User {
  id String @id @default(uuid())

  /// Stable, human-readable identity: USR-00001, USR-00002, ...
  /// Assigned once at signup and NEVER changed. The username can be corrected
  /// for spelling and the name can be edited, but this stays fixed, so results
  /// and reports always point at the same person.
  publicId String @unique @default(dbgenerated("('USR-'::text || lpad((nextval('user_public_id_seq'::regclass))::text, 5, '0'::text))"))

  /// firstname+lastname, then +1, +2 on collision. Editable by an admin.
  username String @unique

  firstName String
  lastName  String

  // Stored as codes referencing SchoolClass rows so analytics never has to
  // cope with "8th" / "VIII" / "8 th" being the same class.
  grade    String
  division String
  rollNo   String

  dateOfBirth DateTime @db.Date

  passwordHash       String
  mustChangePassword Boolean @default(false)

  role     Role    @default(STUDENT)
  isActive Boolean @default(true)

  /// Which parts of the admin area this user may use, e.g.
  /// ["users.manage", "tests.manage"]. Always empty for a student.
  ///
  /// Stored as codes rather than a join table because the list is short, read
  /// on every request, and needs to survive a restore without foreign keys to
  /// reconcile. lib/permissions.ts is the source of truth for valid codes and
  /// drops anything it does not recognise, so a retired code cannot linger and
  /// grant access.
  permissions String[] @default([])

  sessions Session[]

  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  passwordSetAt DateTime  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete: results survive the user being removed

  meta Json @default("{}")

  attempts            Attempt[]
  authoredQuestions   Question[]           @relation("QuestionCreatedBy")
  generationRuns      GenerationRun[]      @relation("RunRequestedBy")
  practiceTests       Test[]               @relation("PracticeTarget")
  createdTests        Test[]               @relation("TestCreatedBy")
  auditLogs           AuditLog[]
  backups             BackupArchive[]
  activities          Activity[]           @relation("ActivityCreatedBy")
  targetedActivities  Activity[]           @relation("ActivityTarget")
  activityCompletions ActivityCompletion[]

  // A roll number is unique inside a class, not globally.
  @@unique([grade, division, rollNo], name: "roll_in_class")
  @@index([role, isActive])
  @@index([grade, division])
  @@index([deletedAt])
}

/// Grades and divisions as data, so the admin can add "Grade 13" or
/// "Division G" from the UI without a schema change or a redeploy.
model SchoolClass {
  id        String   @id @default(uuid())
  kind      String // "GRADE" | "DIVISION"
  code      String // canonical value stored on User.grade / User.division
  label     String // what the dropdown shows
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  meta      Json     @default("{}")

  @@unique([kind, code])
  @@index([kind, isActive, sortOrder])
}

// --- Curriculum ------------------------------------------------------------

/// Self-referencing tree: Subject -> Topic -> Subtopic. Arbitrary depth, so a
/// future "unit" or "chapter" level slots in without a migration.
model CurriculumNode {
  id       String           @id @default(uuid())
  parentId String?
  parent   CurriculumNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children CurriculumNode[] @relation("NodeTree")

  level String // "SUBJECT" | "TOPIC" | "SUBTOPIC"
  code  String // stable machine key, never renamed
  label String // human label, freely renamable
  path  String // denormalised "algebra/quadratics/discriminant" for fast filtering

  grade     String? // optional: scope a topic to one grade
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  meta      Json     @default("{}")

  questions Question[]

  @@unique([parentId, code])
  @@index([level, isActive])
  @@index([path])
}

/// The tag vocabulary. Three orthogonal axes, because orthogonality is what
/// makes "weak at APPLICATION-level ALGEBRAIC_MANIPULATION in Quadratics at
/// MODERATE difficulty" fall out of the data automatically.
model Tag {
  id          String   @id @default(uuid())
  axis        TagAxis
  code        String // stable key used in Question columns and LLM output
  label       String
  description String? // shown to the admin, and injected into the LLM prompt
  /// Ordinal weight along the axis: difficulty easy=1 moderate=2 difficult=3.
  /// Lets analytics compute a weighted mastery score, not just a raw count.
  weight      Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  meta        Json     @default("{}")

  @@unique([axis, code])
  @@index([axis, isActive, sortOrder])
}

// --- Questions -------------------------------------------------------------

model Question {
  id String @id @default(uuid())

  status QuestionStatus @default(DRAFT)
  format QuestionFormat @default(MCQ_SINGLE)

  /// Rendered content as an ordered list of typed blocks:
  ///   { version: 1, blocks: [
  ///       { type: "text",    value: "..." },
  ///       { type: "math",    tex: "\\frac{a}{b}", display: true },
  ///       { type: "svg",     svg: "<svg .../>" },
  ///       { type: "mermaid", code: "graph TD; A-->B" },
  ///       { type: "chart",   spec: { kind:"line", series:[...] } },
  ///       { type: "image",   assetId: "uuid", alt: "..." },
  ///       { type: "table",   headers: [...], rows: [[...]] },
  ///       { type: "code",    language: "python", value: "..." }
  ///   ]}
  /// A future "simulation" block type needs only a new renderer component.
  content Json

  /// [{ id: "a", blocks: [...] }, ...] - always four options, ids a/b/c/d.
  options Json @default("[]")

  /// Shape depends on `format`:
  ///   MCQ_SINGLE  { correctOptionId: "b" }
  ///   MCQ_MULTI   { correctOptionIds: ["a","c"], partialCredit: true }
  /// Never sent to a student before their attempt is submitted.
  answerKey Json

  // --- Images -------------------------------------------------------------
  // None of the supported text providers can produce a picture, so a question
  // that needs one is flagged here and carries a ready-to-use generation
  // prompt. The admin takes that prompt to any image tool, then uploads the
  // result. A flagged question cannot be approved until an image is attached,
  // so an incomplete question can never reach a student.

  /// True when the question cannot be understood without a picture.
  imageRequired Boolean @default(false)

  /// Present only when imageRequired is true:
  ///   { version: 1,
  ///     prompt: "A right-angled triangle ABC with the right angle at B...",
  ///     description: "what the picture must show, in plain words",
  ///     details: ["label the vertices A, B, C", "mark AB = 3 cm"],
  ///     style: "clean black-and-white line diagram, white background",
  ///     widthPx: 800, heightPx: 600, aspectRatio: "4:3",
  ///     altText: "Right-angled triangle ABC",
  ///     placement: "STEM" | "OPTION",
  ///     optionId: "b" }
  imagePrompt Json?

  /// Set once an admin has attached the picture, so the review queue can show
  /// "3 questions still waiting for an image".
  imageFulfilled Boolean @default(false)

  /// Worked solution, same block format as `content`.
  explanation Json @default("{\"version\":1,\"blocks\":[]}")

  // --- Tag axes: real columns because every analytics query filters on them.
  difficultyTag String // Tag.code where axis = DIFFICULTY
  cognitiveTag  String // Tag.code where axis = COGNITIVE
  skillTags     String[] @default([]) // Tag.code[] where axis = SKILL

  curriculumNodeId String?
  curriculumNode   CurriculumNode? @relation(fields: [curriculumNodeId], references: [id], onDelete: SetNull)

  // Denormalised from the curriculum tree so a single-table scan can group by
  // subject/topic without recursive joins. Kept in sync on write.
  subject  String
  topic    String?
  subtopic String?
  grade    String?

  /// Admin's estimate, in seconds. Feeds the suggested test duration.
  estimatedSeconds Int @default(60)

  // --- Provenance: lets the admin see which prompt produces good questions.

  /// Who put this question into the bank - whoever ran the generation or the
  /// import. A question is visible only to its author and to a holder of
  /// admins.manage, so two colleagues preparing different papers do not see
  /// each other's drafts.
  ///
  /// Nullable because questions created before authorship existed have no
  /// author to name; those are treated as belonging to everybody, since
  /// retro-assigning them to whoever happens to hold the account would be a
  /// guess.
  createdById String?
  createdBy   User?   @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  generationRunId String?
  generationRun   GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  sourceModel     String?
  isAdminEdited   Boolean        @default(false)
  reviewNote      String?

  // --- Live difficulty, recomputed from real attempts.
  timesServed  Int   @default(0)
  timesCorrect Int   @default(0)
  observedP    Float @default(0) // timesCorrect / timesServed

  contentVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  meta Json @default("{}")

  testQuestions TestQuestion[]
  answers       Answer[]
  assets        Asset[]

  @@index([createdById, status])
  @@index([status, subject])
  @@index([status, imageRequired, imageFulfilled])
  @@index([difficultyTag, cognitiveTag])
  @@index([subject, topic, subtopic])
  @@index([generationRunId])
  @@index([skillTags], type: Gin)
}

/// Binary content (admin uploads, or a rendered diagram cached to disk).
/// Content-addressed by SHA-256 so identical images are stored once and a
/// restore can verify integrity.
model Asset {
  id         String  @id @default(uuid())
  kind       String // "IMAGE" | "RENDERED_DIAGRAM"
  mimeType   String
  byteSize   Int
  sha256     String
  storageKey String // path under the uploads volume
  width      Int?
  height     Int?
  altText    String?

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  meta      Json     @default("{}")

  @@index([sha256])
  @@index([questionId])
}

// --- LLM generation --------------------------------------------------------

/// A saved, reusable prompt. Kept separate from the run so editing a prompt
/// never rewrites the history of questions produced by the old version.
model PromptTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  systemPrompt String   @db.Text
  userTemplate String   @db.Text // supports {{subject}}, {{topic}}, {{count}} ...
  kind         TestKind @default(REGULAR)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meta         Json     @default("{}")

  runs GenerationRun[]

  @@index([kind, isActive])
}

/// One click of "Generate questions". Stores the exact prompt and the raw
/// response so a bad batch can be diagnosed after the fact.
model GenerationRun {
  id     String           @id @default(uuid())
  status GenerationStatus @default(PENDING)

  requestedById String
  requestedBy   User   @relation("RunRequestedBy", fields: [requestedById], references: [id])

  provider String // "openrouter" | "nvidia" | "custom"
  model    String

  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)

  // Frozen copies: the template may be edited later, this run must not change.
  systemPrompt String @db.Text
  userPrompt   String @db.Text

  /// { subject, topic, subtopic, grade, count, marksPerQuestion,
  ///   difficultyMix: { easy: 4, moderate: 4, difficult: 2 },
  ///   cognitiveMix: {...}, skillFocus: [...], formats: [...] }
  requestSpec Json

  kind TestKind @default(REGULAR)

  // For practice generation: whose weak areas seeded this run.
  targetUserId String?

  rawResponse   String? @db.Text
  errorMessage  String? @db.Text
  parseAttempts Int     @default(0)

  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?

  questionsRequested Int @default(0)
  questionsParsed    Int @default(0)
  questionsAccepted  Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  meta        Json      @default("{}")

  questions Question[]

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([targetUserId])
}

/// LLM provider credentials. The key itself is AES-256-GCM encrypted at rest
/// with ENCRYPTION_KEY and is never returned to any client in full.
model ApiCredential {
  id           String   @id @default(uuid())
  provider     String // "openrouter" | "nvidia" | "custom"
  label        String
  baseUrl      String
  encryptedKey String   @db.Text
  keyHint      String // last 4 characters, for the admin to identify it
  defaultModel String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meta         Json     @default("{}")

  @@index([provider, isActive])
}

// --- Tests -----------------------------------------------------------------

model Test {
  id String @id @default(uuid())

  /// Stable, human-readable test identifier: TST-0001, TST-0002, ...
  /// Printed on the paper and shown in every report, so a test can be referred
  /// to unambiguously even if its title is later edited.
  publicId String @unique @default(dbgenerated("('TST-'::text || lpad((nextval('test_public_id_seq'::regclass))::text, 4, '0'::text))"))

  title       String
  description String?    @db.Text
  kind        TestKind   @default(REGULAR)
  status      TestStatus @default(DRAFT)

  subject String
  grade   String?

  // Audience. Empty arrays mean "everyone", so a test can be class-scoped
  // without a separate join table until one is actually needed.
  targetGrades    String[] @default([])
  targetDivisions String[] @default([])

  // Practice tests are aimed at exactly one student and are always segregated
  // from REGULAR results in every chart and every export.
  targetUserId String?
  targetUser   User?   @relation("PracticeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  marksPerQuestion Float @default(1)
  negativeMarks    Float @default(0) // positive number = amount deducted
  durationMinutes  Int   @default(30)
  maxAttempts      Int   @default(1)
  passPercentage   Float @default(35)

  shuffleQuestions Boolean @default(true)
  shuffleOptions   Boolean @default(true)

  /// Whether the correct answers and explanations appear alongside the score
  /// once results are released. Turn off to reuse the paper with another class.
  showAnswersAfter Boolean @default(true)

  // --- Releasing results --------------------------------------------------
  // Submitting a paper never reveals the score. An administrator releases the
  // results for a whole test in one action, once everyone has finished.
  //
  // PRACTICE tests are exempt: they exist for the student to learn from, so
  // their results are always visible immediately and the release controls do
  // not apply to them. `resultsAreVisible` in services/attempt.ts is the single
  // place that decides.
  resultsReleased   Boolean   @default(false)
  resultsReleasedAt DateTime?
  releasedById      String?

  // Absolute open and close instants for the test as a whole.
  startsAt DateTime?
  endsAt   DateTime?

  // --- Daily availability window ------------------------------------------
  // Independent of startsAt/endsAt: those bound the test overall, this
  // controls which hours of the day it may be attempted. Wall-clock times in
  // the school's timezone (Setting "school.timezone"), stored as minutes from
  // local midnight so a window survives a timezone change intact.
  availabilityMode  AvailabilityMode @default(ALWAYS)
  /// 0..1439. An end earlier than the start wraps past midnight.
  windowStartMinute Int?
  windowEndMinute   Int?
  /// 0 = Sunday .. 6 = Saturday. Empty means every day.
  windowDays        Int[]            @default([])
  /// When the window closes, submit any attempt still in progress. Off by
  /// default: a student who started in time is normally allowed to finish.
  autoSubmitOnClose Boolean          @default(false)

  createdById String
  createdBy   User   @relation("TestCreatedBy", fields: [createdById], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  meta Json @default("{}")

  questions TestQuestion[]
  attempts  Attempt[]

  @@index([status, kind, startsAt])
  @@index([targetUserId])
  @@index([createdById])
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  position Int
  marks    Float // copied from the test, overridable per question

  @@unique([testId, questionId])
  @@index([testId, position])
}

// --- Attempts and answers --------------------------------------------------

model Attempt {
  id     String        @id @default(uuid())
  testId String
  test   Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status AttemptStatus @default(IN_PROGRESS)

  attemptNumber Int @default(1)

  /// Frozen per-attempt shuffle, so a page reload or a reconnect on another
  /// device shows the exact same order:
  ///   { questionIds: [...], optionOrder: { questionId: ["c","a","b"] } }
  layout Json @default("{}")

  startedAt   DateTime  @default(now())
  /// Server-authoritative deadline. The client clock is never trusted.
  expiresAt   DateTime
  submittedAt DateTime?
  lastSeenAt  DateTime  @default(now())

  score      Float @default(0)
  maxScore   Float @default(0)
  percentage Float @default(0)

  correctCount    Int @default(0)
  incorrectCount  Int @default(0)
  unansweredCount Int @default(0)

  /// Per-axis breakdown computed once at submit, so the student dashboard and
  /// the admin analytics never recompute it:
  ///   { byDifficulty: { easy: {correct,total}, ... },
  ///     byCognitive:  {...}, bySkill: {...}, byTopic: {...} }
  breakdown Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meta      Json     @default("{}")

  answers Answer[]

  @@unique([testId, userId, attemptNumber])
  @@index([userId, status])
  @@index([testId, status])
  @@index([submittedAt])
}

model Answer {
  id        String  @id @default(uuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  /// Shape mirrors the answer key:
  ///   { optionId: "b" } | { optionIds: [...] } | { value: true } | { value: 3.14 }
  response Json?

  isCorrect         Boolean?
  marksAwarded      Float    @default(0)
  timeSpentMs       Int      @default(0)
  visitCount        Int      @default(0)
  isMarkedForReview Boolean  @default(false)

  answeredAt DateTime?
  updatedAt  DateTime  @updatedAt
  meta       Json      @default("{}")

  @@unique([attemptId, questionId])
  @@index([questionId, isCorrect])
}

// --- Operations ------------------------------------------------------------

model BackupArchive {
  id             String  @id @default(uuid())
  filename       String
  byteSize       Int
  sha256         String
  /// Archives are plain .tar.gz. Keep them somewhere private - they contain
  /// password hashes and LLM API keys.
  isEncrypted    Boolean @default(false)
  includesAssets Boolean @default(true)
  /// { schemaVersion, appVersion, tableCounts: {...}, createdAtUtc }
  manifest       Json    @default("{}")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  meta      Json      @default("{}")

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // "user.deactivate", "test.publish", "backup.create", ...
  entity    String?
  entityId  String?
  ip        String?
  /// Before/after snapshot for anything the admin changed.
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Loose key/value application settings, so a new toggle never needs a
/// migration. Values are JSON to keep types intact.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --- Activities ------------------------------------------------------------

/// A short piece of learning an administrator can put in front of students:
/// a set of flashcards, a video, or both. When `isMandatory` is set, a
/// targeted student is stopped at the door until they have been through it.
model Activity {
  id String @id @default(uuid())

  /// Stable ACT-0001 identifier, like tests and users.
  publicId String @unique @default(dbgenerated("('ACT-'::text || lpad((nextval('activity_public_id_seq'::regclass))::text, 4, '0'::text))"))

  title       String
  description String? @db.Text

  kind   ActivityKind   @default(FLASHCARD)
  status ActivityStatus @default(DRAFT)

  /// Flashcards, reusing the very same block format as questions, so a card
  /// can hold maths, an SVG diagram, a chart or a table - not just text:
  ///   { version: 1, cards: [ { id, title?, blocks: [Block, ...] } ] }
  content Json @default("{\"version\":1,\"cards\":[]}")

  /// Normalised by lib/video.ts. `videoEmbedUrl` is only ever set for
  /// YouTube/Vimeo; anything else opens in a new tab instead of being framed.
  videoUrl      String?
  videoEmbedUrl String?
  videoProvider String?

  /// Seconds the student must spend before it can be marked done. 0 = none.
  /// A crude but honest guard against clicking straight past it.
  minSeconds Int @default(0)

  /// The point of the feature: block everything else until it is done.
  isMandatory Boolean @default(true)

  // Audience, exactly as for tests. Empty arrays mean everyone.
  targetGrades    String[] @default([])
  targetDivisions String[] @default([])
  targetUserId    String?
  targetUser      User?    @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  startsAt DateTime?
  endsAt   DateTime?

  createdById String
  createdBy   User   @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  meta Json @default("{}")

  completions ActivityCompletion[]

  @@index([status, isMandatory])
  @@index([targetUserId])
  @@index([createdById])
}

/// One student's progress through one activity. Created when they open it,
/// completed when they reach the end and the minimum time has elapsed.
model ActivityCompletion {
  id String @id @default(uuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// When the last heartbeat arrived. Time is credited from the gap between
  /// beats, so the client never gets to declare how long it spent.
  lastBeatAt DateTime @default(now())

  /// Accumulated on the server from heartbeats, not trusted from the client.
  secondsSpent Int     @default(0)
  /// How far through the cards they got, so a half-finished pass is visible.
  cardsSeen    Int     @default(0)
  videoOpened  Boolean @default(false)

  meta Json @default("{}")

  @@unique([activityId, userId])
  @@index([userId, completedAt])
  @@index([activityId, completedAt])
}

/// A signed-in session.
///
/// The JWT carries only a `jti` pointing here, so a session can actually be
/// ended: signing out, an idle timeout, an administrator resetting a password,
/// or the same account signing in somewhere else all revoke the row and the
/// token stops working on the very next request. A JWT on its own can only be
/// waited out.
model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Rolls forward on every request, throttled - this is what an idle timeout
  /// is measured from.
  lastSeenAt DateTime @default(now())
  /// The absolute deadline, regardless of activity.
  expiresAt  DateTime

  revokedAt     DateTime?
  /// Why it ended, so "you were signed out" can say something useful:
  /// signed_out | idle | superseded | password_changed | revoked
  revokedReason String?

  /// Recorded to tell the student which device took their place.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  meta Json @default("{}")

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
